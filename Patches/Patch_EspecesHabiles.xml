<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Le singe vanilla est la seule espèce « mains habiles » du jeu de base.
       Les mods d'animaux peuvent ajouter la leur avec la même opération. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Monkey"]</xpath>
    <value>
      <li Class="AnimalsAtWork.Monkeys.ModExtension_MainsHabiles" />
    </value>
  </Operation>

</Patch>
